"""Local-only simulated fill model.

PAPER-ONLY / DATA-ONLY. No live trading. No order submission.
"""
from datetime import datetime, timezone
from typing import Any, Dict, Optional

from paper_simulator.cost_model import compute_costs


DEFAULT_CONTRACT_SIZE = 100000.0


class FillResult:
    def __init__(
        self,
        fill_id: str,
        intent_id: str,
        timestamp: str,
        symbol: str,
        side: str,
        quantity: float,
        fill_price: float,
        gross_notional: float,
        spread_cost: float,
        slippage_cost: float,
        commission: float,
        total_cost: float,
        simulated: bool = True,
        paper_only: bool = True,
        no_order_submission: bool = True,
        warning: str = "",
    ) -> None:
        self.fill_id = fill_id
        self.intent_id = intent_id
        self.timestamp = timestamp
        self.symbol = symbol
        self.side = side
        self.quantity = quantity
        self.fill_price = fill_price
        self.gross_notional = gross_notional
        self.spread_cost = spread_cost
        self.slippage_cost = slippage_cost
        self.commission = commission
        self.total_cost = total_cost
        self.simulated = simulated
        self.paper_only = paper_only
        self.no_order_submission = no_order_submission
        self.warning = warning

    def to_dict(self) -> Dict[str, Any]:
        return {
            "fill_id": self.fill_id,
            "intent_id": self.intent_id,
            "timestamp": self.timestamp,
            "symbol": self.symbol,
            "side": self.side,
            "quantity": self.quantity,
            "fill_price": self.fill_price,
            "gross_notional": self.gross_notional,
            "spread_cost": self.spread_cost,
            "slippage_cost": self.slippage_cost,
            "commission": self.commission,
            "total_cost": self.total_cost,
            "simulated": self.simulated,
            "paper_only": self.paper_only,
            "no_order_submission": self.no_order_submission,
            "warning": self.warning,
        }


def _obj_get(obj: Any, key: str, default: Any = None) -> Any:
    if isinstance(obj, dict):
        return obj.get(key, default)
    return getattr(obj, key, default)


def simulate_fill(
    intent: Any,
    price: Optional[float] = None,
    symbol_config: Optional[Dict[str, Any]] = None,
    cost_config: Optional[Dict[str, Any]] = None,
    timestamp: Optional[str] = None,
) -> Optional[FillResult]:
    """Simulate a fill from an order intent. Never submits real orders."""
    side = str(_obj_get(intent, "side", "")).upper()
    if side not in {"BUY", "SELL", "FLATTEN"}:
        return None

    fill_price = float(price or _obj_get(intent, "fill_price", 0.0) or 0.0)
    if fill_price <= 0:
        return None

    symbol_config = symbol_config or {}
    cost_config = cost_config or {}
    contract_size = float(symbol_config.get("contract_size", DEFAULT_CONTRACT_SIZE) or DEFAULT_CONTRACT_SIZE)
    pip_size = float(symbol_config.get("pip_size", 0.0001) or 0.0001)

    target_notional = float(_obj_get(intent, "target_notional", 0.0) or 0.0)
    quantity = float(_obj_get(intent, "quantity", 0.0) or 0.0)

    if quantity <= 0 and side in {"BUY", "SELL"}:
        if target_notional <= 0:
            return None
        quantity = target_notional / (fill_price * contract_size)

    if side == "FLATTEN" and quantity <= 0:
        # Engine may ignore this unless it supplies existing quantity.
        return None

    if quantity <= 0:
        return None

    gross_notional = abs(quantity) * fill_price * contract_size
    costs = compute_costs(
        quantity=abs(quantity),
        fill_price=fill_price,
        pip_size=pip_size,
        contract_size=contract_size,
        costs_config=cost_config,
    )

    if hasattr(costs, "to_dict"):
        c = costs.to_dict()
    else:
        c = dict(costs)

    return FillResult(
        fill_id="fill-" + str(_obj_get(intent, "intent_id", "")),
        intent_id=str(_obj_get(intent, "intent_id", "")),
        timestamp=timestamp or datetime.now(timezone.utc).isoformat(),
        symbol=str(_obj_get(intent, "symbol", "")),
        side=side,
        quantity=quantity,
        fill_price=fill_price,
        gross_notional=gross_notional,
        spread_cost=float(c.get("spread_cost", 0.0)),
        slippage_cost=float(c.get("slippage_cost", 0.0)),
        commission=float(c.get("commission", 0.0)),
        total_cost=float(c.get("total_cost", 0.0)),
        simulated=True,
        paper_only=True,
        no_order_submission=True,
    )
