# === AUTH TOKENS (generate with: openssl rand -hex 32) ===
QUANT_VIEWER_TOKEN=replace_with_64_hex_chars
QUANT_OPERATOR_TOKEN=replace_with_64_hex_chars
QUANT_ADMIN_TOKEN=replace_with_64_hex_chars

# === MODE ===
QUANT_MODE=paper
QUANT_BROKER=paper

# === SAFETY ===
# CONFIRM_LIVE_TRADING=YES  # Uncomment ONLY for live mode

# === FEATURE FLAGS ===
ALLOW_MANUAL_TRADING=YES
# ENABLE_SYSTEMATIC_SIGNALS=YES  # Uncomment to enable systematic signals

# === SQLITE ===
QUANT_SQLITE_PATH=./data/quant_platform.db

# === RATE LIMITING & IP ALLOWLIST ===
ENABLE_IP_ALLOWLIST=true
ALLOWED_IPS=127.0.0.1,::1
RATE_LIMIT_VIEWER_PER_MIN=120
RATE_LIMIT_OPERATOR_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=20
RATE_LIMIT_TRADING_PER_MIN=10

# === PAPER BROKER ===
PAPER_INITIAL_BALANCE=100000.0
PAPER_COMMISSION_PER_LOT=7.0
PAPER_SLIPPAGE_PIPS=0.5
PAPER_LEVERAGE=100.0

# === ACCOUNT ===
ACCOUNT_CURRENCY=USD

# === AUDIT ===
AUDIT_JSONL_PATH=./data/audit.jsonl
